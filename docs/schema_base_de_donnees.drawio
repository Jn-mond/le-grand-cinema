<mxfile host="app.diagrams.net"><diagram name="Base de données Le Grand Cinéma" id="page1"><mxGraphModel dx="1100" dy="1262" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1262" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="d1_titre" value="Le Grand Cinéma — modèle de données (PostgreSQL) — une boîte par table" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=13;fontColor=#374151;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="-3" width="960" height="30" as="geometry"/></mxCell><mxCell id="d1_utilisateur_h" value="utilisateur" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontSize=12;fontColor=#FFFFFF;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="15" y="70" width="265" height="38" as="geometry"/></mxCell><mxCell id="d1_utilisateur" value="id : uuid  [PK]&lt;br&gt;email : text&lt;br&gt;nom : text&lt;br&gt;prenom : text&lt;br&gt;telephone : text ?&lt;br&gt;role : role_utilisateur&lt;br&gt;langue : char&lt;br&gt;actif : boolean&lt;br&gt;cree_at : timestamptz" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;fontSize=11;fontColor=#1F2937;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="15" y="108" width="265" height="153" as="geometry"/></mxCell><mxCell id="d1_reservation_h" value="reservation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontSize=12;fontColor=#FFFFFF;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="15" y="400" width="265" height="38" as="geometry"/></mxCell><mxCell id="d1_reservation" value="id : uuid  [PK]&lt;br&gt;seance_id : bigint  [FK]&lt;br&gt;utilisateur_id : uuid ?  [FK]&lt;br&gt;email : text ?&lt;br&gt;statut : statut_reservation&lt;br&gt;cree_at : timestamptz&lt;br&gt;confirmee_at : timestamptz ?&lt;br&gt;canal : canal_reservation&lt;br&gt;vendeur_id