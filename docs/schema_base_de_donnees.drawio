text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#374151;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="708" y="951" width="60" height="24" as="geometry"/></mxCell><mxCell id="d1_k66" value="0..*" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#374151;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642" y="789" width="60" height="24" as="geometry"/></mxCell><mxCell id="d1_k68" value="1" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#374151;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="708" y="1020" width="60" height="24" as="geometry"/></mxCell><mxCell id="d1_k69" value="0..*" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11;fontColor=#374151;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="642" y="1020" width="60" height="24" as="geometry"/></mxCell><mxCell id="d1_leg" value="Légende :  [PK] clé primaire · [FK] clé étrangère · ? colonne facultative (peut être vide) · 0..* zéro ou plusieurs · 1..* un ou plusieurs · 0..1 zéro ou un" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="20" y="1107" width="960" height="30" as="geometry"/></mxCell><mxCell id="d1_leg2" value="salle_id est répété dans billet et verrou_place : des clés étrangères composites (séance + salle, place + salle) garantissent qu'une place appartient bien à la salle de la séance." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="20" y="1139" width="960" height="30" as="geometry"/></mxCell><mxCell id="d1_leg3" value="evenement_paiement n'a volontairement aucune clé étrangère : c'est un journal technique qui évite de traiter deux fois le même message du prestataire de paiement." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="20" y="1171" width="960" height="30" as="geometry"/></mxCell><mxCell id="d1_leg4" value="Entre utilisateur et reservation, le lien de gauche est le client (utilisateur_id, vide pour une réservation « invité »), celui de droite le vendeur au guichet (vendeur_id)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="20" y="1203" width="960" height="30" as="geometry"/></mxCell><mxCell id="d1_e_utilisateur_reservation_h_25" value="" style="endArrow=none;startArrow=none;html=1;rounded=0;strokeColor=#374151;strokeWidth=1.4;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.3;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1_utilisateur" target="d1_reservation_h"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d1_e_utilisateur_reservation_h_28" value="" style="endArrow=none;startArrow=none;html=1;rounded=0;strokeColor=#374151;strokeWidth=1.4;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1_utilisateur" target="d1_reservation_h"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d1_e_reservation_commande_h_31" value="" style="endArrow=none;startArrow=none;html=1;rounded=0;strokeColor=#374151;strokeWidth=1.4;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d1_reservation" target="d1_commande_h"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="d1_e_reservation_seance_34" value="" style="endArrow=none;startArrow=none;html=1;rounded=0;strokeColor=#374151;strokeWidth=1.4;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.0931200701139353;exitDx=0;exitDy=0;entryX=0;entryY=0.2424004192872119;entryDx=0;entryDy=0;" edge="1" parent="1" so