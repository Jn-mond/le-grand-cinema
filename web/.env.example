# Copier ce fichier en .env.local et le compléter. .env.local n'est jamais commité.
# Valeurs : Supabase > Project Settings > API (Vercel : Settings > Environment Variables).

# URL du projet Supabase
SUPABASE_URL=https://votre-projet.supabase.co
# Clé secrète (service_role ou sb_secret_…) : côté serveur uniquement, jamais dans le navigateur
SUPABASE_SERVICE_ROLE_KEY=

# Connexion des utilisateurs (Supabase Auth). Ces deux valeurs sont visibles par le navigateur :
# c'est sans danger, la clé publique n'ouvre aucune donnée (RLS). Voir docs/authentification.md.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Paiement en ligne (E4), Stripe en MODE TEST uniquement. Deux valeurs secrètes, côté serveur :
# jamais de préfixe NEXT_PUBLIC_. Aucune clé publique (pk_test_) n'est utile : la page de
# paiement est hébergée par Stripe. Voir docs/paiement.md.
# Clé secrète de test : Stripe > Développeurs > Clés API (commence par sk_test_)
STRIPE_SECRET_KEY=
# Secret de signature du webhook (commence par whsec_) : fourni par « stripe listen » en local,
# ou par Stripe > Développeurs > Webhooks pour le site en ligne (deux valeurs différentes)
STRIPE_WEBHOOK_SECRET=
