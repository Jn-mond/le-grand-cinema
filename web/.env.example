# Copier ce fichier en .env.local et le compléter. .env.local n'est jamais commité.
# Valeurs : Supabase > Project Settings > API (Vercel : Settings > Environment Variables).

# URL du projet Supabase
SUPABASE_URL=https://votre-projet.supabase.co
# Clé secrète (service_role ou sb_secret_…) : côté serveur uniquement, jamais dans le navigateur
SUPABASE_SERVICE_ROLE_KEY=

# Connexion des utilisateurs (Supabase Auth). Ces deux valeurs sont visibles par le navigateur :
# c'est sans danger, la clé publique n'ouvre aucune donnée (RLS). Voir docs/authentification.md.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
